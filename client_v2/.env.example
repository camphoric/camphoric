# Dev-server proxy target for /api (the Django backend). Optional; defaults to
# http://localhost:8000/ when unset.
VITE_API_PROXY=http://localhost:8000/

# Google Maps API key for the address-autocomplete field (Places API New).
# Optional — with no key the address field falls back to plain inputs. (DR-23)
VITE_GOOGLE_MAPS_API_KEY=
