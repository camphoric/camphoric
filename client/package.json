{
  "name": "camphoric-client",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3001",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static --quiet"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@mantine/core": "^8.3.18",
    "@mantine/dates": "^8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/modals": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@monaco-editor/react": "^4.7.0",
    "@paypal/react-paypal-js": "^10.6.0",
    "@rjsf/core": "^6.11.0",
    "@rjsf/mantine": "^6.11.0",
    "@rjsf/utils": "^6.6.2",
    "@rjsf/validator-ajv8": "^6.11.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-table": "^8.21.3",
    "d3-dsv": "^3.0.1",
    "handlebars": "^4.7.10",
    "json-logic-js": "^2.0.5",
    "luxon": "^3.5.0",
    "match-sorter": "^8.3.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-international-phone": "^4.8.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.2",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-dsv": "^3.0.7",
    "@types/google.maps": "^3.66.6",
    "@types/hast": "^3.0.5",
    "@types/json-logic-js": "^2.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.5",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
