{%- set parking_short = {
  "Long Term": "LT",
  "Vehicle Camp 1": "V1",
  "Vehicle Camp 2": "V2",
  "Vehicle Camp 3": "V3",
  "Short Term": "ST",
  "Camp 1": "C1",
  "Camp 2": "C2",
  "Camp 3": "C3",
  "Park Anywhere": "PA",
} -%}
first, last, crew, lodging, park, email, session, days, parking passes, parking name
{% for camper in campers | sort(attribute="attributes.session,attributes.last_name") if camper.attributes.session == 'Half camp - 1st half' or camper.attributes.session == 'Half camp - 2nd half'-%}
    {%- set crew = camper.registration.registration_type.name if camper.registration.registration_type -%}
    {%- set full_path = camper.lodging.full_name if camper.lodging else '' -%}
    {%- set lodging_short = full_path
        | regex_replace('Tent→Area [A-M]→Spot ', 'Tnt')
        | replace('Camp ', 'C')
        | replace('Cabin→', '')
        | replace('RV under 15\' long→Spot ', '')
        | replace('RV 15\'-20\' long→Spot ', '')
        | replace('RV over 20\' long (call ahead)→Spot ', '')
        | replace('RV→', '')
        | replace('Cooks Cabin', 'Cook')
        | replace('Cabin ', 'Cbn') -%}
    {%- set passes = camper.attributes.parking_passes or [] -%}
    {%- set parking = none -%}
    {%- if passes | length > 0 -%}
        {%- set parking = passes[0].pass_type or 'Long Term' -%}
        {%- set parking = 'Vehicle Camp 1' if 'Camp 1' in full_path and 'RV' in full_path else parking -%}
        {%- set parking = 'Vehicle Camp 2' if 'Camp 2' in full_path and 'RV' in full_path else parking -%}
        {%- set parking = 'Vehicle Camp 3' if 'Camp 3' in full_path and 'RV' in full_path else parking -%}
    {%- endif -%}
  {{ camper.attributes.first_name }},
  {{- camper.attributes.last_name }},
  {{- crew or 'camper' }},
  {{- lodging_short}},
  {{- parking_short[parking] or '-'}},
  {{- camper.attributes.email or camper.registration.registrant_email or '-'}},
  {{- camper.attributes.session}},
  {{- (camper.stay or []) | list | length }},
  {#- Passes belong to each camper now (they were the registration's): the count is the
      camper's own, and the name is whoever holds passes on the registration, as the
      registration's first camper used to. -#}
  {%- set pass_holder = camper if passes else (camper.registration.campers | selectattr('attributes.parking_passes') | first) -%}
  {%- set pass_holder = pass_holder or camper.registration.campers[0] -%}
  {{- passes | length }},
  {{- '"' ~ (pass_holder.attributes.last_name or '') }}, {{- pass_holder.attributes.first_name }}"
{% endfor -%}