{%- set camps = ['Camp 3'] -%}
{%- set parking_short = {
  "Long Term": "LT",
  "Vehicle Camp 1": "V1",
  "Vehicle Camp 2": "V2",
  "Vehicle Camp 3": "V3",
  "Short Term": "ST",
  "Camp 1": "C1",
  "Camp 2": "C2",
  "Camp 3": "C3",
  "Park Anywhere": "PA",
} -%}
{%- set rows = [] -%}
{%- for camper in campers -%}
    {% set full_path = camper.lodging.full_name if camper.lodging else '' %}
    {% set camp = '' %}
    {% set camp = 'Camp 1' if full_path.startswith('Camp 1') else camp %}
    {% set camp = 'Camp 2' if full_path.startswith('Camp 2') else camp %}
    {% set camp = 'Camp 3' if full_path.startswith('Camp 3') else camp %}
    {%- set crew = camper.registration.registration_type.name if camper.registration.registration_type -%}
    {% set lodging_short = full_path | regex_replace('Tent→Area [A-M]→Spot ', 'Tnt') %}
    {% set lodging_short = lodging_short | replace('Camp ', 'C') %}
    {% set lodging_short = lodging_short | replace('Cabin→', '') %}
    {% set lodging_short = lodging_short | replace('RV under 15\' long→Spot ', '') %}
    {% set lodging_short = lodging_short | replace('RV 15\'-20\' long→Spot ', '') %}
    {% set lodging_short = lodging_short | replace('RV over 20\' long (call ahead)→Spot ', '') %}
    {% set lodging_short = lodging_short | replace('RV→', '') %}
    {% set lodging_short = lodging_short | replace('Cooks Cabin', 'Cook') %}
    {% set lodging_short = lodging_short | replace('Cabin ', 'Cbn') %}
    {% set parking = none %}
    {% if (camper.attributes.parking_passes or []) | length > 0 %}
        {% set parking = camper.attributes.parking_passes[0].pass_type or 'Long Term' %}
        {% set parking = 'Vehicle Camp 1' if 'Camp 1' in full_path and 'RV' in full_path else parking %}
        {% set parking = 'Vehicle Camp 2' if 'Camp 2' in full_path and 'RV' in full_path else parking %}
        {% set parking = 'Vehicle Camp 3' if 'Camp 3' in full_path and 'RV' in full_path else parking %}
    {% endif %}
    {% do rows.append({'camper': camper, 'camp': camp, 'crew': crew, 'lodging_short': lodging_short, 'parking': parking}) %}
{%- endfor -%}
first, last, crew, lodging, arrival_date, park, email
{% for row in rows | sort(attribute="camp") | sort(attribute="camper.attributes.last_name") if row.camp in camps -%}
{{ row.camper.attributes.first_name }},
{{- row.camper.attributes.last_name }},
{{- row.crew or 'none' }},
{{- row.lodging_short}},
{{- row.camper.stay[0] }},
{{- parking_short[row.parking] or '-'}},
{{- row.camper.registration.registrant_email  }}
{% endfor -%}