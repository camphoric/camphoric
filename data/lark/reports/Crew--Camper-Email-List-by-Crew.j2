{#- A crew with 'prefix' takes every registration type whose name starts with its name
    (Kitchen: kitchen-full and kitchen-partial). -#}
{%- set crews = [
  {'title': 'Talent Crew', 'name': 'talent' },
  {'title': 'Kitchen Crew', 'name': 'kitchen', 'prefix': true },
  {'title': 'Setup/Teardown Crew', 'name': 'setup-teardown' },
  {'title': 'Cleanup Crew, Camp 1', 'name': 'cleanup-camp-1' },
  {'title': 'Cleanup Crew, Camp 2', 'name': 'cleanup-camp-2' },
  {'title': 'Cleanup Crew, Camp 3', 'name': 'cleanup-camp-3' },
  {'title': 'Office Crew, Camp 1', 'name': 'office-camp-1' },
  {'title': 'Office Crew, Camp 2', 'name': 'office-camp-2' },
  {'title': 'Office Crew, Camp 3', 'name': 'office-camp-3' },
  {'title': 'Management Crew', 'name': 'management' },
  {'title': 'Community Care', 'name': 'community-care' },
] -%}
{%- set rows = [] -%}
{%- for camper in campers | sort(attribute="attributes.last_name") -%}
    {%- do rows.append({'camper': camper, 'crew': (camper.registration.registration_type or {}).name or ''}) -%}
{%- endfor -%}
{%- for crew in crews %}
<br>

**{{ crew.title }}**
<br>
<br>
{%- for row in rows if row.crew == crew.name or (crew.prefix and row.crew.startswith(crew.name)) %}
{%- set camper = row.camper %}
{{camper.attributes.first_name}} {{camper.attributes.last_name}} {{ '&lt;' }}{{camper.attributes.email or camper.registration.registrant_email}}{{ '&gt;' }},
{%- endfor -%}
{%- endfor -%}
