{%- set parking_short = {
  "Long Term": "LT",
  "Vehicle Camp 1": "V1",
  "Vehicle Camp 2": "V2",
  "Vehicle Camp 3": "V3",
  "Short Term": "ST",
  "Camp 1": "C1",
  "Camp 2": "C2",
  "Camp 3": "C3",
  "Park Anywhere": "PA",
} -%}
last, first, crew, lodging, park, email, tent tag, session, row
{% for camper in campers | sort(attribute='attributes.last_name') if not camper.admin_attributes.checked_in -%}
  {%- set crew = camper.registration.registration_type.label if camper.registration.registration_type -%}
  {%- set full_path = camper.lodging.full_name if camper.lodging else '' -%}
  {%- set lodging_short = full_path
      | replace('RV under 15\' long', '')
      | replace('RV 15\'-20\' long', '')
      | replace('RV over 20\' long (call ahead)', '')
      | replace('RV→', 'Vehicle Camping')
      | replace('→Cabin→', '→') -%}
  {%- set lodging_short = lodging_short[:lodging_short.find('→Spot')] if '→Spot' in lodging_short else lodging_short -%}
  {%- set passes = camper.attributes.parking_passes or [] -%}
  {%- set parking = none -%}
  {%- if passes | length > 0 -%}
    {%- set parking = passes[0].pass_type or 'Long Term' -%}
    {%- set parking = 'Vehicle Camp 1' if 'Camp 1' in full_path and 'RV' in full_path else parking -%}
    {%- set parking = 'Vehicle Camp 2' if 'Camp 2' in full_path and 'RV' in full_path else parking -%}
    {%- set parking = 'Vehicle Camp 3' if 'Camp 3' in full_path and 'RV' in full_path else parking -%}
  {%- endif -%}
  {%- set tent_tag_holder = (camper.lodging.campers | selectattr('attributes.session', '==', camper.attributes.session) | sort(attribute="index,attributes.last_name,attributes.first_name") | first) if 'Tent' in full_path -%}
  {{ camper.attributes.last_name }},
  {{- camper.attributes.first_name }},
  {{- crew or 'Camper' }},
  {{- lodging_short}},
  {{- parking_short[parking] or '-'}},
  {{- camper.attributes.email or camper.registration.registrant_email or '-'}},
  {%- if 'Tent' in full_path and tent_tag_holder.id == camper.id -%}
    tent tag {{ full_path[full_path.find('→Spot '):] | replace('→Spot ', '') }}
  {%- elif 'Tent' in full_path -%}
    under {{ tent_tag_holder.attributes.first_name }} {{ tent_tag_holder.attributes.last_name }}
  {%- else -%}
    NONE
  {%- endif -%},
  {{- camper.attributes.session }},
  {{- loop.index }}
{% endfor -%}