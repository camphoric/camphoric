{#- One row per camper: where they eat, their age category and their meals. -#}
{%- set rows = [] -%}
{%- for camper in campers -%}
    {%- set full_name = camper.lodging.full_name if camper.lodging else '' -%}
    {%- set ns = namespace(camp=none) -%}
    {%- for c in ['Camp 1', 'Camp 2', 'Camp 3'] if full_name.startswith(c) -%}
        {%- set ns.camp = c -%}
    {%- endfor -%}
    {%- set meals_in = 'Camp 2' if full_name.startswith('Camp 3') else ns.camp -%}
    {%- set meals = camper.attributes.meals or {} -%}
    {%- do rows.append({
        'meals_in': camper.admin_attributes.meal_assignment_dinner or camper.admin_attributes.meal_assignment_breakfast or meals_in,
        'age_cat': 'Child' if camper.attributes.age in ['0-4 years old', '5-11 years old'] else 'Adult',
        'meal_plan': meals.meal_plan,
        'meal_type': meals.meal_type,
    }) -%}
{%- endfor -%}

{%- for camp in ["Camp 1", "Camp 2"] %}
,,,,,
{{ camp }},Age,Non-Veg,Veg,Vegan,Total
{%- for mplan in ["All Meals", "All Meals - 1st half", "All Meals - 2nd half", "Just Dinners"] -%}
{%- for age in ["Adult", "Child"] %}
{{ mplan }},{{ age }},{% for mtype in ["Non-Vegetarian","Vegetarian","Vegan"] -%}
{{ rows | selectattr("meals_in", "==", camp) | selectattr("meal_plan", "==", mplan) | selectattr("age_cat", "==", age) | selectattr("meal_type", "==", mtype) | list | length }},{% endfor -%}
{{ rows | selectattr("meals_in", "==", camp) | selectattr("meal_plan", "==", mplan) | selectattr("age_cat", "==", age) | list | length }}
{%- endfor -%}
{%- endfor %}
