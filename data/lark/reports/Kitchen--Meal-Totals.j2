{{- rows | selectattr("meals_in", "==", camp) | selectattr("meal_plan","!=","No meals") | selectattr("meal_type", "==", "Vegetarian") | list | length -}},
{{- rows | selectattr("meals_in", "==", camp) | selectattr("meal_plan","!=","No meals") | selectattr("meal_type", "==", "Vegan") | list | length -}},
{{- rows | selectattr("meals_in", "==", camp) | selectattr("meal_plan","!=","No meals") | list | length }}
