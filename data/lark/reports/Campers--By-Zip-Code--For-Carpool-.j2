{%- set rows = [] -%}
{%- for camper in campers -%}
    {%- set full_path = camper.lodging.full_name if camper.lodging else '' -%}
    {%- set camp = '--' -%}
    {%- set camp = 'Camp 1' if full_path.startswith('Camp 1') else camp -%}
    {%- set camp = 'Camp 2' if full_path.startswith('Camp 2') else camp -%}
    {%- set camp = 'Camp 3' if full_path.startswith('Camp 3') else camp -%}
    {%- set address = (camper.registration.attributes.payment or {}).payer_billing_address -%}
    {%- set address = camper.attributes.camper_address if camper.attributes.address_different_than_payer else address -%}
    {%- set address = address or {} -%}
    {%- do rows.append({'camper': camper, 'camp': camp, 'address': address, 'zip_code': address.zip_code or ''}) -%}
{%- endfor -%}
last, first, crew, diff, zip, state, city, address, country, camp, session, arrival, email, reg_phone
{% for row in rows | sort(attribute="zip_code") -%}
    {%- set camper = row.camper -%}
    {%- set crew = camper.registration.registration_type.name if camper.registration.registration_type -%}
	{{  '"' ~ (camper.attributes.first_name or '') }}",
  {{- '"' ~ (camper.attributes.last_name or '') }}",
  {{- '"' ~ (crew or 'camper') }}",
  {{- '"' ~ (camper.attributes.address_different_than_payer | string) }}",
	{{- '"' ~ (row.address.zip_code or '') }}",
	{{- '"' ~ (row.address.state_or_province or '') }}",
	{{- '"' ~ (row.address.city or '') }}",
	{{- '"' ~ (row.address.street_address or '') }}",
	{{- '"' ~ (row.address.country or '') }}",
  {{- '"' ~ row.camp }}",
  {{- '"' ~ (camper.attributes.session or '') }}",
	{{- '"' ~ ( camper.stay[0] if camper.stay else '??' ) }}",
  {{- '"' ~ (camper.attributes.email or camper.registration.registrant_email or '-')}}",
  {#- TODO: `attributes.phone` isn't a Lark camper field, so this always falls back to the payer's number. #}
  {{- '"' ~ (camper.attributes.phone or (camper.registration.attributes.payment or {}).payer_number or '-')}}"
{% endfor -%}