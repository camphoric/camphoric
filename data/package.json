{
  "name": "camphoric-data-import",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "events/*"
  ],
  "scripts": {
    "import": "tsx --conditions=camphoric-source loadAllData.ts",
    "test": "npm run test:offline && npm test --workspaces --if-present",
    "test:offline": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck && eslint .",
    "build": "npm run build -w packages/event-import-spec && npm run build -w packages/import-tools"
  },
  "dependencies": {
    "@camphoric/camphoric-event-familyweek": "*",
    "@camphoric/camphoric-event-harmony": "*",
    "@camphoric/camphoric-event-import-spec": "^1.0.0",
    "@camphoric/camphoric-event-import-tools": "^1.0.0",
    "@camphoric/camphoric-event-lark": "*",
    "@camphoric/camphoric-event-ltacampout": "*",
    "cli-progress": "^3.12.0",
    "dotenv": "^18.0.4",
    "lodash": "^4.17.21",
    "ora": "^9.4.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/cli-progress": "^3.11.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.5",
    "eslint": "^9.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
