{
  // Compiles the package to dist/ (JavaScript, declarations and maps) for
  // publishing, with the spec's shared compiler options.
  "extends": "@camphoric/camphoric-event-import-spec/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["*.ts"]
}
