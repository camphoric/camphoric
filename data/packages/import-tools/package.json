{
  "name": "@camphoric/camphoric-event-import-tools",
  "version": "1.0.0",
  "description": "Camphoric REST client, login, the event importer (creator and organization loader), e2e scaffolding for an event's registration form, and the runner that posts generated registrations to an event.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camphoric/camphoric.git",
    "directory": "data/packages/import-tools"
  },
  "type": "module",
  "files": [
    "dist",
    "CamphoricFetcher.ts",
    "CamphoricEventCreator.ts",
    "getAuthInfo.ts",
    "bulkRegistrations.ts",
    "organizations.ts",
    "types.ts",
    "utils.ts",
    "e2e.ts",
    "e2eImport.ts",
    "e2eRegistrationForm.ts",
    "e2eServer.ts",
    "e2e-compose.yml",
    "CHANGELOG.md"
  ],
  "exports": {
    "./fetcher": {
      "camphoric-source": "./CamphoricFetcher.ts",
      "types": "./dist/CamphoricFetcher.d.ts",
      "default": "./dist/CamphoricFetcher.js"
    },
    "./auth": {
      "camphoric-source": "./getAuthInfo.ts",
      "types": "./dist/getAuthInfo.d.ts",
      "default": "./dist/getAuthInfo.js"
    },
    "./bulk-registrations": {
      "camphoric-source": "./bulkRegistrations.ts",
      "types": "./dist/bulkRegistrations.d.ts",
      "default": "./dist/bulkRegistrations.js"
    },
    "./creator": {
      "camphoric-source": "./CamphoricEventCreator.ts",
      "types": "./dist/CamphoricEventCreator.d.ts",
      "default": "./dist/CamphoricEventCreator.js"
    },
    "./organizations": {
      "camphoric-source": "./organizations.ts",
      "types": "./dist/organizations.d.ts",
      "default": "./dist/organizations.js"
    },
    "./types": {
      "camphoric-source": "./types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./e2e": {
      "camphoric-source": "./e2e.ts",
      "types": "./dist/e2e.d.ts",
      "default": "./dist/e2e.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "dotenv": "^18.0.4",
    "inquirer": "^14.2.2",
    "lodash": "^4.17.21",
    "ora": "^9.4.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@camphoric/camphoric-event-import-spec": "*",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/cli-progress": "^3.11.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
