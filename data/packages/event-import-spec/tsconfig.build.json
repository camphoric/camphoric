{
  // Compiles the package to dist/ (JavaScript, declarations and maps) for
  // publishing.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["*.ts"]
}
