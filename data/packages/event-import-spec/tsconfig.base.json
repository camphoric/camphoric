{
  // Compiler options shared by every @camphoric/camphoric-event-* package and the
  // importer. The source runs with tsx: .ts files are imported by name, and the
  // syntax only needs its types stripped. Published packages are compiled from
  // the same source (tsconfig.build.json, with rewriteRelativeImportExtensions).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true
  }
}
