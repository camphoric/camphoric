{#- Campers per night, by lodging group. -#}
{%- set groups = [
  ['v1', ['Village 1', 'Village 5', 'Village 6']],
  ['v2', ['Village 2']],
  ['v4', ['Apartments']],
  ['v7', ['Village 7', 'Wellness']],
  ['RV', ['RV Camping', 'Tent Camping']],
] -%}
{%- set totals = {} -%}
{%- for camper in campers if camper.lodging -%}
    {%- for night in event.nights if night in (camper.stay or []) -%}
        {%- for key, places in groups -%}
            {%- for place in places if place in camper.lodging.path_names -%}
                {%- do totals.update({night ~ key: totals.get(night ~ key, 0) + 1}) -%}
            {%- endfor -%}
        {%- endfor -%}
    {%- endfor -%}
{%- endfor -%}
Day | Village 1, 5&6 | Village 2 | Village 4 | Village 7& Wellness | RV/Tent | Total
--- | -------------- | --------- | --------- | ------------------- | ------- | -----
{% for night in event.nights -%}
    {%- set ns = namespace(total=0) -%}
    {{ night | date('%a') }} |{% for key, places in groups %} {{ totals.get(night ~ key, 0) }} |{% set ns.total = ns.total + totals.get(night ~ key, 0) %}{% endfor %} {{ ns.total }} |
{% endfor -%}
TOTALS |{% for key, places in groups %}{% set ns = namespace(total=0) %}{% for night in event.nights %}{% set ns.total = ns.total + totals.get(night ~ key, 0) %}{% endfor %} {{ ns.total }} |{% endfor %} {{ totals.values() | sum }} |
