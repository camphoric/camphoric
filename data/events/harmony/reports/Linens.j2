{#- Linens needed per night, by lodging group. -#}
{%- set groups = [
  ['v1', ['Village 1', 'Village 5', 'Village 6']],
  ['v2', ['Village 2']],
  ['v4', ['Apartments']],
  ['v7', ['Village 7', 'Wellness']],
] -%}
{%- set totals = {} -%}
{%- for camper in campers if camper.lodging and camper.attributes.linens in (true, 'Yes') -%}
    {%- for night in event.nights if night in (camper.stay or []) -%}
        {%- for key, places in groups -%}
            {%- for place in places if place in camper.lodging.path_names -%}
                {%- do totals.update({night ~ key: totals.get(night ~ key, 0) + 1}) -%}
            {%- endfor -%}
        {%- endfor -%}
    {%- endfor -%}
{%- endfor -%}
