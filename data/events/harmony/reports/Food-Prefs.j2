{#- Meals per night by meal type and dietary exceptions. -#}
{%- set types = [['O', 'Omnivore'], ['V', 'Vegetarian'], ['E', 'Vegan']] -%}
{%- set exceptions = [['D', 'Dairy Free'], ['G', 'Gluten Free'], ['W', 'Whole Grain']] -%}
{%- set combinations = [
  ['None', ''],
  ['🚫Dairy', 'D'],
  ['🚫Gluten', 'G'],
  ['WholeGrain', 'W'],
  ['🚫Dairy+🚫Gluten', 'DG'],
  ['🚫Dairy+WholeGrain', 'DW'],
  ['🚫Gluten+WholeGrain', 'GW'],
  ['🚫Dairy+🚫Gluten+WholeGrain', 'DGW'],
] -%}
{#- summary: per night, each meal type and each exception; per_night: type + exceptions. -#}
{%- set summary = {} -%}
{%- set per_night = {} -%}
{%- for c in campers -%}
    {%- set exc = c.attributes.meal_exceptions or [] -%}
    {%- set code = exceptions | selectattr(1, 'in', exc) | map(attribute=0) | join -%}
    {%- for night in event.nights if night in (c.stay or []) -%}
        {%- for letter, meal_type in types if c.attributes.meal_type == meal_type -%}
            {%- do summary.update({night ~ letter: summary.get(night ~ letter, 0) + 1}) -%}
            {%- do per_night.update({night ~ letter ~ code: per_night.get(night ~ letter ~ code, 0) + 1}) -%}
        {%- endfor -%}
        {%- for letter, name in exceptions if name in exc -%}
            {%- do summary.update({night ~ letter: summary.get(night ~ letter, 0) + 1}) -%}
        {%- endfor -%}
    {%- endfor -%}
{%- endfor -%}
