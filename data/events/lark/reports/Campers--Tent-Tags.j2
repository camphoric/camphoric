{%- set session_short = {
  "Full camp": "",
  "Half camp - 1st half": "1st",
  "Half camp - 2nd half": "2nd",
} -%}
campers,session,camp,tag
{% for spot in lodgings | sort(attribute="full_name") if spot.is_leaf and 'Tent' in spot.full_name and (spot.campers | length) -%}
{% for session in ["Full camp", "Half camp - 1st half", "Half camp - 2nd half"] -%}
{%- if (spot.campers | selectattr('attributes.session', '==', session) | list | length) < 1 -%}
  {%- continue -%}
{%- endif -%}
"{%- for camper in spot.campers | sort(attribute="index,attributes.last_name,attributes.first_name") if camper.attributes.session == session -%}
    {{- camper.attributes.first_name }} {{	camper.attributes.last_name }}{{- ',' if not loop.last else '' -}}
{%- endfor -%}",
  {{- session_short[session] }},
  {{- spot.path_names[0] -}},
  {{- spot.path_names[-1].removeprefix('Spot ') }}{%- if '1st' in session -%}A{%- elif '2nd' in session -%}B{%- else -%}{%- endif %}
{% endfor -%}
{%- endfor -%}