{%- set parking_short = {
  "Long Term": "LT",
  "Vehicle Camp 1": "V1",
  "Vehicle Camp 2": "V2",
  "Vehicle Camp 3": "V3",
  "Short Term": "ST",
  "Camp 1": "C1",
  "Camp 2": "C2",
  "Camp 3": "C3",
  "Park Anywhere": "PA",
} -%}
{#- TODO: no registration type's label contains "Registration" any more, so only campers
    marked registration_volunteer are listed. -#}
last, first, crew, lodging, park, email, parking, tent tag, session, row
{% for camper in campers | sort(attribute='attributes.last_name') if camper.admin_attributes.registration_volunteer or 'Registration' in (camper.registration.registration_type.label if camper.registration.registration_type else '') -%}
  {%- set registration_type = camper.registration.registration_type -%}
  {%- set crew = registration_type.label if registration_type else '' -%}
  {%- set full_lodging_path = camper.lodging.full_name if camper.lodging else '' -%}
  {%- set lodging_short = full_lodging_path -%}
  {%- set lodging_short = lodging_short | replace('RV under 15\' long', '') -%}
  {%- set lodging_short = lodging_short | replace('RV 15\'-20\' long', '') -%}
  {%- set lodging_short = lodging_short | replace('RV over 20\' long (call ahead)', '') -%}
  {%- set lodging_short = lodging_short | replace('RV→', 'Vehicle Camping') -%}
  {%- set lodging_short = lodging_short | replace('→Cabin→', '→') -%}
  {%- if '→Spot' in lodging_short -%}
    {%- set lodging_short = lodging_short[:lodging_short.find('→Spot')] -%}
  {%- endif -%}
  {%- set parking_passes = camper.attributes.parking_passes or [] -%}
  {%- set parking = none -%}
  {%- if parking_passes | length > 0 -%}
    {%- set parking = parking_passes[0].pass_type or 'Long Term' -%}
    {%- if 'Camp 1' in full_lodging_path and 'RV' in full_lodging_path -%}{%- set parking = 'Vehicle Camp 1' -%}{%- endif -%}
    {%- if 'Camp 2' in full_lodging_path and 'RV' in full_lodging_path -%}{%- set parking = 'Vehicle Camp 2' -%}{%- endif -%}
    {%- if 'Camp 3' in full_lodging_path and 'RV' in full_lodging_path -%}{%- set parking = 'Vehicle Camp 3' -%}{%- endif -%}
  {%- endif -%}
  {%- set tent_tag_holder = none -%}
  {%- if 'Tent' in full_lodging_path -%}
    {%- set tent_tag_holder = camper.lodging.campers | selectattr('attributes.session', '==', camper.attributes.session) | sort(attribute="index,attributes.last_name,attributes.first_name") | first -%}
  {%- endif -%}
  {{ camper.attributes.last_name }},
  {{- camper.attributes.first_name }},
  {{- crew or 'Camper' }},
  {{- lodging_short}},
  {{- parking_short[parking] or '-'}},
  {{- camper.attributes.email or camper.registration.registrant_email or '-'}},
  {#- Passes belong to each camper now; a camper without one who shares a registration
      with someone who has passes is shown under them (as registration passes were). -#}
  {%- set pass_holder = camper.registration.campers | selectattr('attributes.parking_passes') | first -%}
  {%- if (parking_passes | length) == 1 -%}
    1 parking pass
  {%- elif (parking_passes | length) > 1 -%}
    {{- parking_passes | length }} parking passes
  {%- elif pass_holder -%}
    under {{ pass_holder.attributes.first_name }} {{ pass_holder.attributes.last_name }}
  {%- else -%}
    NONE
  {%- endif -%},
  {%- if 'Tent' in full_lodging_path and tent_tag_holder.id == camper.id -%}
    tent tag {{ full_lodging_path[full_lodging_path.find('→Spot '):] | replace('→Spot ', '') }}
  {%- elif 'Tent' in full_lodging_path -%}
    under {{ tent_tag_holder.attributes.first_name }} {{ tent_tag_holder.attributes.last_name }}
  {%- else -%}
    NONE
  {%- endif -%},
  {{- camper.attributes.session }},
  {{- loop.index }}
{% endfor -%}