{%- set rows = [] -%}
{%- for camper in campers -%}
    {%- set crew = camper.registration.registration_type.name if camper.registration.registration_type -%}
    {#- The cleanup crews (cleanup-camp-1/2/3) share the 'cleanup' leads. -#}
    {%- set crew_key = 'cleanup' if crew and crew.startswith('cleanup') else crew -%}
    {%- set full_path = camper.lodging.full_name if camper.lodging else '' -%}
    {%- set camp = none -%}
    {%- set camp = 'Camp 1' if full_path.startswith('Camp 1') else camp -%}
    {%- set camp = 'Camp 2' if full_path.startswith('Camp 2') else camp -%}
    {%- set camp = 'Camp 3' if full_path.startswith('Camp 3') else camp -%}
    {%- set parking = none -%}
    {%- if (camper.attributes.parking_passes or []) | length > 0 -%}
        {%- set parking = camper.attributes.parking_passes[0].pass_type or 'Long Term' -%}
        {%- set parking = 'Vehicle Camp 1' if 'Camp 1' in full_path and 'RV' in full_path else parking -%}
        {%- set parking = 'Vehicle Camp 2' if 'Camp 2' in full_path and 'RV' in full_path else parking -%}
        {%- set parking = 'Vehicle Camp 3' if 'Camp 3' in full_path and 'RV' in full_path else parking -%}
    {%- endif -%}
    {%- set comp_reason = none -%}
    {%- if camper.stay and camper.stay[0] == event.start -%}
        {%- set comp_reason = 'gift' if camper.admin_attributes.precamp_meals_comp else comp_reason -%}
        {%- set comp_reason = 'kitchen' if crew == 'kitchen-full' else comp_reason -%}
        {%- set comp_reason = 'kitchen' if crew == 'kitchen-partial' else comp_reason -%}
        {%- set comp_reason = 'cleanup' if crew and crew.startswith('cleanup') else comp_reason -%}
        {%- set comp_reason = 'setup' if crew == 'setup-teardown' else comp_reason -%}
        {#- TODO: there is no 'registration' registration type any more, so this never matches. -#}
        {%- set comp_reason = 'reg' if crew == 'registration' else comp_reason -%}
        {%- set comp_reason = 'manage' if crew == 'management' else comp_reason -%}
        {%- set comp_reason = 'trade' if camper.admin_attributes.food_trade_only else comp_reason -%}
    {%- endif -%}
    {%- do rows.append({'camper': camper, 'crew': crew, 'crew_key': crew_key, 'full_path': full_path,
        'camp': camp, 'parking': parking, 'comp_reason': comp_reason}) -%}
{%- endfor -%}
last,first,lodging,registration_type,parking_type,stay,balance_due,meal_plan,meal_location,first_day,precamp_meal_comp,crew,crew_leader,crew_leader_email
{% for row in rows | sort(attribute="full_path") if row.crew_key in crewLeadLookup.keys() -%}
    {%- set camper = row.camper -%}
    {%- set lead = crewLeadLookup[row.crew_key][row.camp] if row.crew and row.camp -%}
    {{- camper.attributes.last_name }},
    {{- camper.attributes.first_name }},
    {{- row.full_path}},
    {{- row.crew or 'none' }},
    {{- parking_short[row.parking] or '-'}},
    {{- camper.attributes.session}},
    {{- '$' ~ camper.registration.balance }},
    {{- (camper.attributes.meals or {}).meal_plan }},
    {#- TODO: `meal_assignment` isn't a Lark camper admin field (there are meal_assignment_breakfast
        and meal_assignment_dinner), so this always shows the camp. -#}
    {{- camper.admin_attributes.meal_assignment or row.camp }},
    {{- camper.stay[0]}},
    {{- row.comp_reason or '' }},
    {{- row.crew or '' }},
    {{- lead.lead if lead else '' }},
    {{- lead.email if lead else '' }}
{% endfor %}