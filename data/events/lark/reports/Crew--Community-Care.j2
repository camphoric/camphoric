{%- set crew = 'community-care' -%}
{%- set parking_short = {
  "Long Term": "LT",
  "Vehicle Camp 1": "V1",
  "Vehicle Camp 2": "V2",
  "Vehicle Camp 3": "V3",
  "Short Term": "ST",
  "Camp 1": "C1",
  "Camp 2": "C2",
  "Camp 3": "C3",
  "Park Anywhere": "PA",
} -%}
{#- The camper's lodging, shortened: "Camp 1→Tent→Area A→Spot 3" → "C1→Tnt3". -#}
{%- macro lodging_short(lodging) -%}
    {%- set ns = namespace(short=lodging.full_name if lodging else '') -%}
    {%- for l in ['A','B','C','D','E','F','G','H','I','J','K','L','M'] -%}
        {%- set ns.short = ns.short | replace('Tent→Area ' + l + '→Spot ', 'Tnt') -%}
    {%- endfor -%}
    {{- ns.short
        | replace('Camp ', 'C')
        | replace('Cabin→', '')
        | replace('RV under 15\' long→Spot ', '')
        | replace('RV 15\'-20\' long→Spot ', '')
        | replace('RV over 20\' long (call ahead)→Spot ', '')
        | replace('RV→', '')
        | replace('Cooks Cabin', 'Cook')
        | replace('Cabin ', 'Cbn') -}}
{%- endmacro -%}
{#- The camper's parking: their first pass's type, or the vehicle camp for an RV spot. -#}
{%- macro parking(camper) -%}
    {%- set passes = camper.attributes.parking_passes or [] -%}
    {%- if passes | length > 0 -%}
        {%- set full = camper.lodging.full_name if camper.lodging else '' -%}
        {%- set ns = namespace(parking=passes[0].pass_type or 'Long Term') -%}
        {%- set ns.parking = 'Vehicle Camp 1' if 'Camp 1' in full and 'RV' in full else ns.parking -%}
        {%- set ns.parking = 'Vehicle Camp 2' if 'Camp 2' in full and 'RV' in full else ns.parking -%}
        {%- set ns.parking = 'Vehicle Camp 3' if 'Camp 3' in full and 'RV' in full else ns.parking -%}
        {{- ns.parking -}}
    {%- endif -%}
{%- endmacro -%}
first, last, crew, lodging, arrival_date, park, badge, email
{% for camper in campers | sort(attribute="attributes.last_name") if (camper.registration.registration_type or {}).name == crew -%}
{%- set crew_type = camper.registration.registration_type or {} -%}
{{ camper.attributes.first_name }},
{{- camper.attributes.last_name }},
{{- crew_type.label or 'none' }},
{{- lodging_short(camper.lodging) }},
{{- camper.stay[0] if camper.stay }},
{{- parking_short[parking(camper)] or '-'}},
{{- '✔️' if (camper.attributes.name_badge or {}).purchase or '' }},
{{- camper.registration.registrant_email }}
{% endfor -%}
