{%- set camp1 = lodgings | selectattr("name", "==", "Camp 1") | first | default({}) -%}
{%- set camp2 = lodgings | selectattr("name", "==", "Camp 2") | first | default({}) -%}
{%- set camp3 = lodgings | selectattr("name", "==", "Camp 3") | first | default({}) -%}
{%- set offsite = lodgings | selectattr("name", "==", "Off Site") | first | default({}) -%}
{%- set dates = (campers | selectattr("stay") | sum(attribute="stay", start=[])) | unique | sort -%}

{%- for camp in [camp1, camp2, camp3, offsite] -%}
{%- set adults_overnight = [] | list -%}
{%- set under_5_overnight = [] | list %}

## {{ camp.name }}

{% for camper in campers -%}
{%- set clodge = camper.lodging -%}
{%- if not camper.admin_attributes.checked_in -%}
	{%- continue -%}
{%- endif -%}
{%- if not clodge -%}
	{%- continue -%}
{%- endif -%}
{%- if not camp.name in clodge.path_names -%}
  {%- continue -%}
{%- endif -%}
{%- if camper.attributes.age == '0-4 years old' -%}
    {%- do under_5_overnight.extend(camper.stay) -%}
{%- elif not camper.attributes.age == '0-4 years old' and camper.stay is not none-%}
    {%- do adults_overnight.extend(camper.stay) -%}
{%- endif -%}
{%- endfor -%}

{%- set datess = (adults_overnight + under_5_overnight) | unique | sort -%}

{%- if datess -%}
|     | {{ dates | join(" | ") }} |
| --- | {% for d in dates %} --- |{% endfor %}
| Adults | {% for d in dates %} {{ adults_overnight |  select('==', d) | list | count }} |{% endfor %}
| < 5 yo | {% for d in dates %} {{ under_5_overnight | select('==', d) | list | count }} |{% endfor %}
{%- else -%}
 {{ camp.name }} table will display when populated; currently no one staying in {{ camp.name }}
{%- endif -%}

{% endfor -%}