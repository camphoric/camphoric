{
  "name": "@camphoric/camphoric-event-sample-camp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sample Camp: a made-up Camphoric event that exercises the whole import contract, for this repository's own tests. Never published.",
  "files": [
    "dist",
    "reports",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "camphoric-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "e2e": "NODE_OPTIONS=--conditions=camphoric-source playwright test"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  },
  "peerDependencies": {
    "@camphoric/camphoric-event-import-spec": "^1.0.0"
  },
  "devDependencies": {
    "@camphoric/camphoric-event-import-spec": "*",
    "@camphoric/camphoric-event-import-tools": "*",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
