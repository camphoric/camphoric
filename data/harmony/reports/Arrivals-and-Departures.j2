{#- Arrivals (first night) and departures (last night stayed), by lodging group. -#}
{%- set groups = [
  ['v1', ['Village 1']],
  ['v2', ['Village 2']],
  ['v4', ['Apartments']],
  ['v5', ['Village 5', 'Village 6']],
  ['v7', ['Village 7']],
  ['vW', ['Wellness']],
  ['vT', ['RV Camping', 'Tent Camping']],
] -%}
{%- set totals = {} -%}
{%- for camper in campers if camper.lodging and camper.stay -%}
    {%- set stay = camper.stay | sort -%}
    {%- for key, places in groups -%}
        {%- for place in places if place in camper.lodging.path_names -%}
            {%- do totals.update({stay[0] ~ key ~ 'a': totals.get(stay[0] ~ key ~ 'a', 0) + 1}) -%}
            {%- do totals.update({stay[-1] ~ key ~ 'd': totals.get(stay[-1] ~ key ~ 'd', 0) + 1}) -%}
        {%- endfor -%}
    {%- endfor -%}
{%- endfor -%}
{%- macro table(suffix) -%}
| Day | Village1 | Village2 | Village4 (apt) | Village5&6 | Village7 | Wellness | RV/Tent | Total |
| --- | -------- | -------- | -------- | ---------- | -------- | -------- | ------- | ----- |
{% for night in event.nights -%}
{%- set ns = namespace(total=0) -%}
| {{ night | date('%a') }} |{% for key, places in groups %} {{ totals.get(night ~ key ~ suffix, 0) }} |{% set ns.total = ns.total + totals.get(night ~ key ~ suffix, 0) %}{% endfor %} {{ ns.total }} |
{% endfor -%}
{%- endmacro -%}
