{%- for camper in campers if camper.lodging -%}
    {%- set val = lodgingLookup[camper.lodging | string] -%}
    {%- do camper.update({'ldg': val.pathParts if val else [] }) -%}
    {%- for dt in dates -%}
        {%- if dt[0] in (camper.stay or []) -%}
            {%- if 'Village 1' in (val.pathParts) and camper.attributes.linens in (true, 'Yes') -%}{%- do totals.update({dt.0 ~ 'v1': totals[dt.0~'v1'] + 1}) -%}{%- endif -%}
            {%- if 'Village 5' in (val.pathParts) and camper.attributes.linens in (true, 'Yes') -%}{%- do totals.update({dt.0 ~ 'v1': totals[dt.0~'v1'] + 1}) -%}{%- endif -%}
            {%- if 'Village 6' in (val.pathParts) and camper.attributes.linens in (true, 'Yes') -%}{%- do totals.update({dt.0 ~ 'v1': totals[dt.0~'v1'] + 1}) -%}{%- endif -%}
            {%- if 'Village 2' in (val.pathParts) and camper.attributes.linens in (true, 'Yes') -%}{%- do totals.update({dt.0 ~ 'v2': totals[dt.0~'v2'] + 1}) -%}{%- endif -%}
            {%- if 'Apartments' in (val.pathParts) and camper.attributes.linens in (true, 'Yes') -%}{%- do totals.update({dt.0 ~ 'v4': totals[dt.0~'v4'] + 1}) -%}{%- endif -%}
            {%- if 'Village 7' in (val.pathParts) and camper.attributes.linens in (true, 'Yes') -%}{%- do totals.update({dt.0 ~ 'v7': totals[dt.0~'v7'] + 1}) -%}{%- endif -%}
            {%- if  'Wellness' in (val.pathParts) and camper.attributes.linens in (true, 'Yes') -%}{%- do totals.update({dt.0 ~ 'v7': totals[dt.0~'v7'] + 1}) -%}{%- endif -%}
        {%- endif -%}
    {%- endfor -%}
{%- endfor -%}
