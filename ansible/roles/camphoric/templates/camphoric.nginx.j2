server_tokens off;

server {
    include mime.types;
    server_name {{ camphoric_domain_name }};

    location {{ camphoric_hosted_location }} {
      client_max_body_size 10M; # some uploads to django can get large
      root /usr/share/nginx/html/;
      index  index.html index.htm;
      try_files $uri $uri/index.html @proxy_django;
    }

    # An event's live change feed (SPEC DR-112): passed on as it comes, and
    # left open (the server pings every 20 s and closes after 30 min).
    location ~ ^/api/events/\d+/stream/$ {
      include proxy_params;
      proxy_http_version 1.1;
      proxy_set_header Connection '';
      proxy_buffering off;
      proxy_read_timeout 1h;
      {% if camphoric_environment == 'development' %}
      proxy_pass http://localhost:8000;
      {% else %}
      proxy_pass http://unix:/run/camphoric.sock;
      {% endif %}
    }

    location @proxy_django {
      include proxy_params;
      {% if camphoric_environment == 'development' %}
      proxy_pass http://localhost:8000;
      {% else %}
      proxy_pass http://unix:/run/camphoric.sock;
      {% endif %}
    }

    {%- if nginx_ssl_on | bool %}

    # HTTP/2, so admins' live-update streams don't use up the browser's few
    # HTTP/1.1 connections to the site (SPEC DR-112).
    listen 443 ssl http2; # managed by Certbot

    ssl_certificate /etc/letsencrypt/live/{{ camphoric_domain_name }}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/{{ camphoric_domain_name }}/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    {% else %}

    listen 80;

    {% endif %}

}

{%- if nginx_ssl_on | bool %}

server {
    if ($host = {{ camphoric_domain_name }}) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80 default_server;
    server_name {{ camphoric_domain_name }};
    return 404; # managed by Certbot
}

{%- endif %}
