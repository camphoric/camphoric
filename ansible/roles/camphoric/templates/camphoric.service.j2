[Unit]
Description=camphoric daemon
After=network.target
{% if camphoric_environment != 'development' -%}
Requires=camphoric.socket
{%- else -%}
{# The VM's own database: up before the migrations below run. #}
After=postgresql.service
Wants=postgresql.service
{%- endif %}

[Service]
User={{ camphoric_user }}
Group={{ camphoric_user }}
WorkingDirectory={{ camphoric_folder }}/server

{% if camphoric_environment == 'development' %}
{# The ASGI server, reloading on changes, so the live change feed works (DR-112);
   a reload doesn't wait on admins' open feeds, which reconnect. It polls for
   changes, since a VirtualBox shared folder passes on no file events. #}
Environment=WATCHFILES_FORCE_POLLING=true
{# Apply pending migrations whenever the server starts (each `vagrant up`, a
   restart, a provision), as the Docker django service does. The leading "-"
   starts the server even if they fail; `journalctl -u camphoric` says why.
   They get 4 minutes (a lock held by an open psql session can make them wait):
   `timeout` then stops them with an error the "-" forgives, inside the unit's
   own start limit, which would otherwise fail the whole unit. #}
ExecStartPre=-/usr/bin/timeout 240 {{ pipenv_bin }} run python manage.py migrate --noinput
TimeoutStartSec=300
ExecStart={{ pipenv_bin }} run uvicorn \
          camphoric_server.asgi:application \
          --reload --timeout-graceful-shutdown 2 --host 0.0.0.0 --port 8000
{% else %}
{# Only nginx reaches the socket, so its X-Forwarded-Proto is trusted: links stay https. #}
ExecStart={{ pipenv_bin }} run gunicorn \
          --access-logfile - \
          --worker-class uvicorn_worker.UvicornWorker \
          --forwarded-allow-ips=* \
          --workers 3 \
          --bind unix:/run/camphoric.sock \
          camphoric_server.asgi:application
{% endif %}

[Install]
WantedBy=multi-user.target
