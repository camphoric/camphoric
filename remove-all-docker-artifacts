#!/bin/bash

function usage() {
    cat <<EOF
Usage: $0 [-yf] [service...]

This will PERMANENTLY delete the containers, volumes (the database included),
networks and built images of this compose project (${PWD##*/}). Images pulled
by tag (postgres, node) and other projects' artifacts are left alone.

Given service names, it only removes those services' containers and their
anonymous volumes; the database volume and the images are kept.
EOF

}

while getopts yfh flag
do
    case "${flag}" in
        y) force=1;;
        f) force=1;;
        h) usage && exit 0;;
        [?]) echo >&2 "$(usage)" && exit 1;;
    esac
done

shift $((OPTIND-1)) # remove all flag arguments

if [ -z "$force" ]
then
    RED='\033[1;31m'
    NC='\033[0m' # No Color

    printf "${RED}WARNING: THIS CANNOT BE UNDONE${NC}\n"
    if [ $# -eq 0 ]
    then
        echo "This will delete the containers, volumes (the database included), networks and built images of ${PWD##*/}"
    else
        echo "This will delete the containers and anonymous volumes of: $*"
    fi

    while true; do
        read -p "Do you wish to proceed [y/n]? " yn
        case $yn in
            [Yy]* ) break;;
            [Nn]* ) exit;;
            * ) echo "Please answer yes or no.";;
        esac
    done
fi

# Scoped to this compose project: `--rmi local` only removes the images it
# built, not ones pulled by tag, so other projects' artifacts are untouched
# (./remove-unused-docker-artifacts is the machine-wide prune).
if [ $# -eq 0 ]
then
    docker compose down --rmi local --volumes --remove-orphans
else
    docker compose rm -sfv "$@"
fi
