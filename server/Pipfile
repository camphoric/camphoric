# See https://pip.pypa.io/en/stable/getting-started/

[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
freezegun = "*"
flake8 = "*"

[packages]
django = "~=6.1"
djangorestframework = ">=3.18"
django-environ = "*"
# psycopg 3, built against the system libpq; its async connections serve the live change feed.
psycopg = {extras = ["c"], version = ">=3.2"}
json-logic-qubit = "*"
# Reads Mustache emails so migration 0065 can convert them to Jinja (templating/mustache.py).
chevron = "*"
cmarkgfm = "*"
requests = "*"
django-dbbackup = "*"
django-storages = {extras = ["boto3"], version = "*"}
django-filter = ">=26.1"
jsonschema = {extras = ["format"], version = "*"}
jinja2 = "*"
deepmerge = "*"
whitenoise = "*"
gunicorn = "*"
# gunicorn runs Django's ASGI app through uvicorn's workers (DR-111).
uvicorn = {extras = ["standard"], version = "*"}
uvicorn-worker = "*"
django-tasks-db = "*"
cryptography = "*"
django-auditlog = ">=3.4"

[requires]
python_version = "3.12"
